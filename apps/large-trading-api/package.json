{
  "name": "large-trading-api",
  "version": "1.0.0",
  "description": "Backtesting API for cryptos, stocks etc.",
  "main": "index.js",
  "scripts": {
    "start": "npm run remove:dist && tsc && tsc-alias && node --max-old-space-size=16384 dist/apps/large-trading-api/src/app.js",
    "start:board": "rm -rf log && python -m webbrowser http://localhost:6006/ && tensorboard --logdir=log",
    "test": "npm run remove:dist && jest",
    "remove:dist": "rm -rf dist",
    "lint": "npx eslint \"**/*.ts\"",
    "lint:fix": "npx eslint --fix \"**/*.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janv93/large-trading-api.git"
  },
  "keywords": [
    "large",
    "trading",
    "api",
    "stocks",
    "crypto",
    "strategy",
    "backtest"
  ],
  "author": "janv93",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/janv93/large-trading-api/issues"
  },
  "homepage": "https://github.com/janv93/large-trading-api#readme",
  "dependencies": {
    "@jest/globals": "^30.4.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "axios": "^1.18.1",
    "body-parser": "^1.20.6",
    "btoa": "^1.2.1",
    "compression": "^1.8.1",
    "config": "^5.0.0",
    "deepmerge": "^4.3.1",
    "dotenv": "^16.4.7",
    "express": "^4.22.2",
    "lodash": "^4.18.1",
    "mongoose": "^9.9.1",
    "oauth": "^0.10.2",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@types/node": "^26.2.0",
    "jest": "^30.4.2",
    "tsc-alias": "^1.8.17"
  }
}
